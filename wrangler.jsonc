{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arche",
  "compatibility_date": "2026-07-08",
  "main": "./worker/index.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths reach the Worker first; everything else is a file.
    "run_worker_first": ["/download/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
